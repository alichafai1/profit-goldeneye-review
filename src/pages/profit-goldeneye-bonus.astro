---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import CtaButton from '../components/CtaButton.astro';
import StickyBar from '../components/StickyBar.astro';

const title = 'The Profit Goldeneye 2.0 Bonus: Claim Your Trading Toolkit';
const description =
	'Get exclusive Goldeneye 2.0 bonuses when you buy through this link. Includes a Forex Risk Management Calculator and a Professional Trading Journal.';
const canonicalURL = 'https://profitgoldeneyereview.com/profit-goldeneye-bonus';
const bonusEmail = 'bonuses@goldeneyereview.com';

const faqs = [
	{
		q: 'Are these bonuses free?',
		a: 'The calculator and the journal are free only when you buy The Profit Goldeneye 2.0 through a button on this page. The indicator itself is $329. These two spreadsheets are not a separate paid product, and they are not a public download.',
	},
	{
		q: 'How will I receive the files?',
		a: 'Forward your JVZoo receipt to bonuses@goldeneyereview.com. The spreadsheet links are emailed to that same address within 24 hours of a confirmed order.',
	},
	{
		q: 'What if I already bought Goldeneye 2.0?',
		a: 'If that order came through a link on this site, forward the JVZoo receipt and the bonuses still apply. Orders placed somewhere else are not covered. These files are only for purchases made from this page.',
	},
	{
		q: 'Do I need the $329 version to get these?',
		a: 'Yes. The bonuses are tied to buying The Profit Goldeneye 2.0, the $329 one-time MT4 and MT5 indicator. There is no way to collect the toolkit without that purchase.',
	},
];

const problems = [
	'Risking too much per trade',
	'Not tracking your win rate',
	'Trading without a plan',
];

const schema = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'Product',
			name: 'Goldeneye 2.0 Trading Toolkit Bonuses',
			description:
				'Forex Risk Management Calculator and Professional Trading Journal included when you buy The Profit Goldeneye 2.0 through this page.',
			brand: {
				'@type': 'Brand',
				name: 'GoldeneyeReview',
			},
			offers: {
				'@type': 'Offer',
				price: '0',
				priceCurrency: 'USD',
				availability: 'https://schema.org/InStock',
				url: 'https://jvz8.com/c/3639697/458096/',
			},
		},
		{
			'@type': 'FAQPage',
			mainEntity: faqs.map((faq) => ({
				'@type': 'Question',
				name: faq.q,
				acceptedAnswer: {
					'@type': 'Answer',
					text: faq.a,
				},
			})),
		},
	],
};
---

<BaseLayout title={title} description={description} canonicalURL={canonicalURL} schema={schema}>
	<section class="hero">
		<div class="container crumbs">
			<Breadcrumbs
				items={[
					{ label: 'Home', href: '/' },
					{ label: 'Bonuses', href: '/profit-goldeneye-bonus' },
				]}
			/>
		</div>
		<div class="container hero-copy">
			<p class="kicker">Private trading toolkit</p>
			<h1>Claim Your Exclusive Goldeneye 2.0 Bonuses</h1>
			<p class="lede">
				Buy The Profit Goldeneye 2.0 through the link on this page, and I’ll send you these private trading
				tools to help you protect your capital and maximize your wins.
			</p>
			<p class="disclosure">
				Affiliate link. The indicator is $329. The two spreadsheets below cost $0 extra when the order comes
				from this page.
			</p>
			<CtaButton class="btn-lg">Get Goldeneye 2.0 + Claim Bonuses →</CtaButton>
			<p class="crosslinks">
				<a href="/">Read our full <strong>Goldeneye 2.0 Review</strong> →</a>
				<a href="/profit-goldeneye-pricing">See the <strong>Goldeneye 2.0 Pricing</strong> →</a>
			</p>
		</div>
	</section>

	<section class="band">
		<div class="container narrow">
			<h2>A Great Signal is Only 50% of the Trade</h2>
			<p class="section-lead">
				Goldeneye gives you the entries. But what happens after you enter? If you don't have a strict risk
				management plan or a way to track your performance, one bad trade can wipe out ten good ones.
			</p>
			<p class="agitate">
				You have a great indicator, but if your risk management is bad, you will still blow your account.
			</p>
			<ul class="pain-list">
				{
					problems.map((item) => (
						<li>
							<svg viewBox="0 0 24 24" aria-hidden="true">
								<path
									d="M6 6l12 12M18 6L6 18"
									fill="none"
									stroke="currentColor"
									stroke-width="2.4"
									stroke-linecap="round"
								/>
							</svg>
							<span>{item}</span>
						</li>
					))
				}
			</ul>
			<p class="solve">These bonuses fix the other 50%.</p>
			<div class="cta-row">
				<CtaButton class="btn-lg">Get Goldeneye 2.0 + Claim Bonuses →</CtaButton>
			</div>
		</div>
	</section>

	<section class="band band-alt" id="stack">
		<div class="container">
			<h2>Here is Exactly What You Get</h2>
			<p class="section-lead intro">
				Two spreadsheets. No course, no upsell inside the files. A lot-size number only helps if you actually
				trade that size.
			</p>
			<div class="bonus-grid">
				<article class="bonus-card">
					<div class="icon" aria-hidden="true">
						<svg viewBox="0 0 48 48">
							<path
								d="M24 5l14 6v11c0 9.2-6 16.4-14 19-8-2.6-14-9.8-14-19V11l14-6z"
								fill="none"
								stroke="currentColor"
								stroke-width="2.2"
							/>
							<path d="M16 27h16M16 22h6M28 18h4M28 22h4M16 18h6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
						</svg>
					</div>
					<p class="worth">Worth $97</p>
					<h3>The Forex Risk Management Calculator</h3>
					<p>
						A custom Excel/Google Sheets calculator. Just input your account size and risk percentage, and
						it tells you the exact lot size to use for every trade. Never blow an account again.
					</p>
				</article>
				<article class="bonus-card">
					<div class="icon" aria-hidden="true">
						<svg viewBox="0 0 48 48">
							<path
								d="M12 8h18l8 8v24a2 2 0 0 1-2 2H12a2 2 0 0 1-2-2V10a2 2 0 0 1 2-2z"
								fill="none"
								stroke="currentColor"
								stroke-width="2.2"
							/>
							<path d="M30 8v8h8M16 26h10M16 32h16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
							<path d="M30 28l3 3 6-7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
						</svg>
					</div>
					<p class="worth">Worth $47</p>
					<h3>The Professional Trading Journal</h3>
					<p>
						A pre-formatted spreadsheet to log your trades, track your win rate, and see which timeframes
						Goldeneye works best for you.
					</p>
				</article>
			</div>

			<div class="value-box">
				<p class="kicker">Included with your order</p>
				<p class="value">Total Bonus Value: $144. Yours Free.</p>
				<p class="value-note">Free means no second charge. The $329 indicator purchase is still required.</p>
				<CtaButton class="btn-lg">Get Goldeneye 2.0 + Claim Bonuses →</CtaButton>
			</div>
		</div>
	</section>

	<section class="band" id="claim">
		<div class="container">
			<h2>How to Claim Your Bonuses (Takes 2 Minutes)</h2>
			<ol class="steps">
				<li>
					<span>01</span>
					<h3>Buy from this page</h3>
					<p>Click the button on this page to buy Goldeneye 2.0.</p>
				</li>
				<li>
					<span>02</span>
					<h3>Send the receipt</h3>
					<p>
						Forward your JVZoo receipt to <a href={`mailto:${bonusEmail}`}>{bonusEmail}</a>.
					</p>
				</li>
				<li>
					<span>03</span>
					<h3>Watch your inbox</h3>
					<p>Check your inbox within 24 hours for your bonus links.</p>
				</li>
			</ol>
			<div class="cta-row">
				<CtaButton class="btn-lg">Get Goldeneye 2.0 + Claim Bonuses →</CtaButton>
			</div>
		</div>
	</section>

	<section class="band band-alt" id="faq">
		<div class="container narrow">
			<h2>Bonus FAQs</h2>
			<div class="faq-list">
				{
					faqs.map((faq, index) => (
						<details name="bonus-faq" open={index === 0}>
							<summary>{faq.q}</summary>
							<p>{faq.a}</p>
						</details>
					))
				}
			</div>
			<div class="cta-row">
				<CtaButton class="btn-lg">Get Goldeneye 2.0 + Claim Bonuses →</CtaButton>
			</div>
		</div>
	</section>

	<section class="final">
		<div class="container final-inner">
			<h2>Claim the toolkit with the indicator</h2>
			<p>
				Goldeneye can show the entry. The calculator tells you the lot size for the risk you chose, and the
				journal shows whether you followed it. Buy through this page, then send the receipt.
			</p>
			<CtaButton class="btn-lg">Get Goldeneye 2.0 + Claim Bonuses →</CtaButton>
			<p class="crosslinks final-links">
				<a href="/">Read our full <strong>Goldeneye 2.0 Review</strong> →</a>
				<a href="/profit-goldeneye-pricing">See the <strong>Goldeneye 2.0 Pricing</strong> →</a>
			</p>
		</div>
	</section>

	<StickyBar />
</BaseLayout>

<style>
	.kicker {
		margin: 0 0 0.8rem;
		color: var(--color-primary);
		font-size: 0.78rem;
		font-weight: 700;
		letter-spacing: 0.14em;
		text-transform: uppercase;
	}

	h2 {
		margin: 0;
		font-size: clamp(1.9rem, 4vw, 2.7rem);
	}

	h3 {
		margin: 0;
		font-size: 1.35rem;
	}

	.hero {
		position: relative;
		padding: 2.2rem 0 4.5rem;
		background:
			radial-gradient(ellipse 70% 55% at 50% -10%, rgba(212, 175, 55, 0.18), transparent 58%),
			linear-gradient(180deg, var(--color-bg-alt) 0%, var(--color-bg) 80%);
		overflow: hidden;
	}

	.hero::before {
		content: '';
		position: absolute;
		inset: 0;
		background-image:
			linear-gradient(rgba(248, 250, 252, 0.035) 1px, transparent 1px),
			linear-gradient(90deg, rgba(248, 250, 252, 0.035) 1px, transparent 1px);
		background-size: 72px 72px;
		mask-image: linear-gradient(180deg, #000 15%, transparent 82%);
		pointer-events: none;
	}

	.crumbs,
	.hero-copy {
		position: relative;
	}

	.hero-copy {
		margin-top: 2rem;
		text-align: center;
	}

	h1 {
		max-width: 14em;
		margin-inline: auto;
		font-size: clamp(2.2rem, 5vw, 3.8rem);
	}

	.lede,
	.section-lead {
		color: var(--color-text-light);
		font-size: 1.08rem;
	}

	.lede {
		max-width: 42rem;
		margin: 1.1rem auto 0;
	}

	.disclosure {
		max-width: 36rem;
		margin: 1rem auto 0;
		color: var(--color-text-light);
		font-size: 0.82rem;
	}

	.hero-copy :global(.btn),
	.cta-row {
		margin-top: 1.5rem;
	}

	.crosslinks {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.75rem 1.4rem;
		margin-top: 1.3rem;
	}

	.crosslinks a {
		color: var(--color-primary);
		text-decoration: none;
	}

	.crosslinks a:hover {
		text-decoration: underline;
	}

	.band {
		padding: 4.5rem 0;
	}

	.band-alt {
		background: linear-gradient(180deg, rgba(19, 27, 42, 0.7), rgba(11, 15, 25, 0));
	}

	.narrow {
		max-width: 820px;
	}

	.section-lead {
		max-width: 44rem;
		margin-top: 1rem;
	}

	.intro {
		margin-bottom: 1.8rem;
	}

	.agitate {
		margin-top: 1.2rem;
		font-family: var(--font-display);
		font-size: 1.35rem;
		font-weight: 600;
	}

	.pain-list {
		display: grid;
		gap: 0.85rem;
		margin: 1.3rem 0 0;
		padding: 0;
		list-style: none;
	}

	.pain-list li {
		display: flex;
		gap: 0.75rem;
		align-items: flex-start;
	}

	.pain-list svg {
		flex: none;
		width: 1.35rem;
		height: 1.35rem;
		margin-top: 0.15rem;
		color: var(--color-danger);
	}

	.solve {
		margin-top: 1.4rem;
		color: var(--color-primary);
		font-family: var(--font-display);
		font-size: 1.25rem;
		font-weight: 600;
	}

	.bonus-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1rem;
	}

	.bonus-card,
	.value-box,
	.final-inner {
		background: var(--color-bg-alt);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
	}

	.bonus-card {
		padding: 1.4rem 1.35rem 1.5rem;
	}

	.icon {
		display: grid;
		place-items: center;
		width: 3.25rem;
		height: 3.25rem;
		margin-bottom: 1rem;
		color: var(--color-primary);
		background: rgba(212, 175, 55, 0.08);
		border: 1px solid rgba(212, 175, 55, 0.35);
		border-radius: var(--radius-md);
	}

	.icon svg {
		width: 1.8rem;
		height: 1.8rem;
	}

	.worth {
		color: var(--color-primary);
		font-size: 0.8rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.bonus-card h3 {
		margin: 0.35rem 0 0.7rem;
	}

	.bonus-card p:last-child {
		color: var(--color-text-light);
	}

	.value-box {
		margin-top: 1.25rem;
		padding: 1.8rem 1.4rem;
		text-align: center;
		border-color: var(--color-primary);
		box-shadow: var(--shadow-glow);
	}

	.value {
		font-family: var(--font-display);
		font-size: clamp(1.7rem, 3vw, 2.3rem);
		font-weight: 700;
		letter-spacing: -0.03em;
	}

	.value-note {
		margin-top: 0.45rem;
		color: var(--color-text-light);
	}

	.steps {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 1rem;
		margin: 1.6rem 0 0;
		padding: 0;
		list-style: none;
	}

	.steps li {
		padding: 1.3rem 1.2rem 1.4rem;
		background: var(--color-bg-alt);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
	}

	.steps span {
		display: block;
		margin-bottom: 0.7rem;
		color: var(--color-primary);
		font-family: var(--font-display);
		font-weight: 700;
		letter-spacing: 0.08em;
	}

	.steps h3 {
		margin-bottom: 0.5rem;
		font-size: 1.2rem;
	}

	.steps p,
	.steps a {
		color: var(--color-text-light);
	}

	.steps a {
		color: var(--color-primary);
	}

	.faq-list {
		display: grid;
		gap: 0.7rem;
		margin-top: 1.4rem;
	}

	details {
		background: var(--color-bg-alt);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-md);
	}

	details[open] {
		border-color: var(--color-primary);
	}

	summary {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding: 1rem 1.1rem;
		font-family: var(--font-display);
		font-weight: 600;
		cursor: pointer;
		list-style: none;
	}

	summary::-webkit-details-marker {
		display: none;
	}

	summary::after {
		content: '+';
		color: var(--color-primary);
		font-size: 1.3rem;
		line-height: 1;
	}

	details[open] summary::after {
		content: '–';
	}

	details p {
		padding: 0 1.1rem 1.05rem;
		color: var(--color-text-light);
	}

	.final {
		padding: 0 0 1rem;
	}

	.final-inner {
		max-width: 820px;
		padding: 2rem 1.4rem 2.1rem;
		text-align: center;
		background:
			radial-gradient(ellipse at top, rgba(212, 175, 55, 0.16), transparent 55%),
			var(--color-bg-alt);
		border-color: var(--color-primary);
		box-shadow: var(--shadow-glow);
	}

	.final-inner p {
		margin-top: 0.85rem;
		color: var(--color-text-light);
	}

	.final-inner :global(.btn) {
		margin-top: 1.4rem;
	}

	.final-links {
		margin-top: 1.1rem;
	}

	@media (max-width: 800px) {
		.bonus-grid,
		.steps {
			grid-template-columns: 1fr;
		}
	}
</style>
