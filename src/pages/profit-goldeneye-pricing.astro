---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import CtaButton from '../components/CtaButton.astro';
import StickyBar from '../components/StickyBar.astro';

const title = 'The Profit Goldeneye 2.0 Pricing: Is $329 Worth It? (Honest Breakdown)';
const description =
	'Complete Goldeneye 2.0 pricing breakdown. Learn what you get for the $329 one-time fee, how it compares to monthly subscriptions, and if it\'s worth the investment.';
const canonicalURL = 'https://www.profitgoldeneye.info/profit-goldeneye-pricing';

const faqs = [
	{
		q: 'Is the $329 a one-time payment or a subscription?',
		a: 'The seller lists Goldeneye 2.0 at $329 once. The sales page does not show a monthly fee for the indicator. You are not signing up for a $50 or $100 bill that renews every month.',
	},
	{
		q: 'Are there any hidden fees or upsells?',
		a: 'The price on the sales page is $329 for the indicator, the license, and the install guide. JVZoo checkouts can offer extra products after you pay. Decline those if you only want Goldeneye. The calculator and journal on this site are not a second charge. They are sent after you forward the receipt.',
	},
	{
		q: 'Which platforms does it work on?',
		a: 'MetaTrader 4 and MetaTrader 5. The seller says both versions are included, with the same panel, grades, and alerts, on any broker that offers MT4 or MT5.',
	},
	{
		q: 'Is there a refund policy?',
		a: 'Yes, and it is strict. Element Forex publishes a 7-day refund limited to two cases: an accidental double purchase, or a technical failure on their side that they confirm. Change of mind, not using the tool, or a losing trade is listed as non-refundable. A refund deactivates the license key. Read that policy on the checkout page before you pay.',
	},
];

const packageItems = [
	{ title: 'The 9-Timeframe Dashboard', copy: 'M1 through monthly in one row, with direction and how long that direction has held.' },
	{ title: 'The SIGHT / FORCE / PULSE Triad', copy: 'Three meters for direction, strength, and timing. The seller says the best grades fire when they agree.' },
	{ title: 'Pop-Up Alerts and Sound', copy: 'A signal window with sound, mute, and a history list so you are not watching the chart all day.' },
	{ title: 'Works on MT4 and MT5', copy: 'Both platforms are listed in the $329 purchase. Same grades, same panel layout.' },
	{ title: 'Drag-Anywhere Panel', copy: 'Move the dashboard on the chart. The seller says it remembers where you left it.' },
	{ title: 'Lifetime access, no monthly fee', copy: 'One payment. No $50 to $100 renewal on the sales page for this indicator.' },
];

const rows = [
	{
		feature: 'Price',
		goldeneye: '$329 one-time',
		tradingview: '$50–$100 / month',
		arrows: '$30 one-time',
	},
	{
		feature: 'Timeframe view',
		goldeneye: '9 timeframes in one panel',
		tradingview: 'Usually one chart at a time',
		arrows: 'The chart you have open',
	},
	{
		feature: 'Triad system',
		goldeneye: 'SIGHT, FORCE, and PULSE',
		tradingview: 'No shared triad',
		arrows: 'No triad',
	},
	{
		feature: 'Signal quality',
		goldeneye: 'EXCELLENT, GOOD, STANDBY',
		tradingview: 'Depends on the script',
		arrows: 'Arrows, often with no grade',
	},
	{
		feature: 'Dashboard',
		goldeneye: 'Full on-chart panel',
		tradingview: 'Script pane or overlay',
		arrows: 'No dashboard. Many repaint.',
	},
];

const schema = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'Product',
			name: 'The Profit Goldeneye 2.0',
			description:
				'One-time MT4 and MT5 indicator with a 9-timeframe dashboard, graded signals, and SIGHT, FORCE, and PULSE meters.',
			brand: { '@type': 'Brand', name: 'Element Forex' },
			offers: {
				'@type': 'Offer',
				price: '329',
				priceCurrency: 'USD',
				availability: 'https://schema.org/InStock',
				url: 'https://jvz8.com/c/3639697/458096/',
			},
			aggregateRating: {
				'@type': 'AggregateRating',
				ratingValue: '4.7',
				bestRating: '5',
				worstRating: '1',
				ratingCount: '1',
				reviewCount: '1',
			},
		},
		{
			'@type': 'FAQPage',
			mainEntity: faqs.map((faq) => ({
				'@type': 'Question',
				name: faq.q,
				acceptedAnswer: { '@type': 'Answer', text: faq.a },
			})),
		},
	],
};
---

<BaseLayout title={title} description={description} canonicalURL={canonicalURL} schema={schema}>
	<section class="hero">
		<div class="container crumbs">
			<Breadcrumbs
				items={[
					{ label: 'Home', href: '/' },
					{ label: 'Pricing', href: '/profit-goldeneye-pricing' },
				]}
			/>
		</div>
		<div class="container hero-copy">
			<p class="kicker">Pricing breakdown</p>
			<h1>The Profit Goldeneye 2.0 Pricing: Is $329 a Smart Investment?</h1>
			<p class="lede">
				Most Forex indicators charge $50 to $100 every month. Goldeneye 2.0 is a $329 one-time fee. Here is the
				honest math on why it might actually be the cheaper option.
			</p>
			<CtaButton class="btn-lg">Get Goldeneye 2.0 for $329 →</CtaButton>
			<p class="crosslinks">
				<a href="/">Read our full <strong>Goldeneye 2.0 Review</strong> →</a>
				<a href="/profit-goldeneye-bonus">Claim your <strong>Exclusive Bonuses</strong> after purchase →</a>
			</p>
		</div>
	</section>

	<section class="band">
		<div class="container">
			<div class="answer">
				<h2>The 30-Second Breakdown</h2>
				<p>
					If you pay $60/month for a TradingView indicator, you spend $720 a year. Goldeneye 2.0 is $329 once.
					If it helps you catch just ONE extra winning trade or avoid ONE bad loss, it pays for itself instantly.
				</p>
				<p class="fine">
					That “one trade” line only holds if you were going to take the trade and the panel actually changed
					the decision. It does not make the next signal a winner, and it will not refund a loss.
				</p>
				<CtaButton class="btn-lg">Get Goldeneye 2.0 for $329 →</CtaButton>
			</div>
		</div>
	</section>

	<section class="band band-alt" id="package">
		<div class="container">
			<h2>The Full Package</h2>
			<p class="section-lead">What Exactly Do You Get for $329?</p>
			<div class="grid">
				{
					packageItems.map((item) => (
						<article>
							<svg viewBox="0 0 24 24" aria-hidden="true">
								<path
									d="M5 12.5l4.2 4.2L19 7.2"
									fill="none"
									stroke="currentColor"
									stroke-width="2.2"
									stroke-linecap="round"
									stroke-linejoin="round"
								/>
							</svg>
							<div>
								<h3>{item.title}</h3>
								<p>{item.copy}</p>
							</div>
						</article>
					))
				}
			</div>
			<div class="cta-row">
				<CtaButton class="btn-lg">Get the full $329 package →</CtaButton>
			</div>
		</div>
	</section>

	<section class="band" id="compare">
		<div class="container">
			<h2>Goldeneye 2.0 vs. The Alternatives</h2>
			<p class="section-lead">
				Typical tools vary. This is the shape of the choice, not a lab test of every script on the market.
			</p>
			<div class="table-scroll">
				<table class="compare">
					<caption>Price and features against monthly scripts and cheap arrow indicators</caption>
					<thead>
						<tr>
							<th scope="col">Feature</th>
							<th class="hl" scope="col">Goldeneye 2.0</th>
							<th scope="col">TradingView premium indicators</th>
							<th scope="col">Cheap MT4 arrow indicators</th>
						</tr>
					</thead>
					<tbody>
						{
							rows.map((row) => (
								<tr>
									<th scope="row">{row.feature}</th>
									<td class="hl" data-label="Goldeneye 2.0">
										{row.goldeneye}
									</td>
									<td data-label="TradingView premium indicators">{row.tradingview}</td>
									<td data-label="Cheap MT4 arrow indicators">{row.arrows}</td>
								</tr>
							))
						}
					</tbody>
				</table>
			</div>
		</div>
	</section>

	<section class="band band-alt">
		<div class="container narrow">
			<h2>Is It Right For Your Budget?</h2>
			<p>
				Do not buy this if you are looking for a 'get rich quick' robot that trades for you. Do not buy this if
				you cannot afford to lose your trading capital. This is a professional tool for serious traders.
			</p>
			<p>
				The $329 is easier to justify than a subscription only if you will still be using the panel months from
				now, and only if you already know how to place a stop. A grade on a chart is not a business plan.
			</p>
			<div class="cta-row">
				<CtaButton class="btn-lg">I'm Ready to Trade Smarter →</CtaButton>
			</div>
		</div>
	</section>

	<section class="band" id="faq">
		<div class="container narrow">
			<h2>Pricing questions</h2>
			<div class="faq-list">
				{
					faqs.map((faq, index) => (
						<details name="pricing-faq" open={index === 0}>
							<summary>{faq.q}</summary>
							<p>{faq.a}</p>
						</details>
					))
				}
			</div>
			<div class="cta-row">
				<CtaButton class="btn-lg">Get Goldeneye 2.0 for $329 →</CtaButton>
			</div>
		</div>
	</section>

	<section class="final">
		<div class="container final-inner">
			<h2>The Final Verdict on Pricing</h2>
			<p>
				For a trader who already pays monthly for chart tools, $329 once is the smaller bill if Goldeneye stays
				on the chart. You get the 9-timeframe panel, the triad, graded signals, and alerts, without a renewal.
			</p>
			<p>
				It is still a high ticket for an indicator, the refund window is narrow, and you still click the trade.
				If that is the tool you wanted, the price is a long-term buy. If you wanted a robot, keep the $329.
			</p>
			<CtaButton class="btn-lg">Get Goldeneye 2.0 for $329 →</CtaButton>
			<p class="crosslinks">
				<a href="/">Read our full <strong>Goldeneye 2.0 Review</strong> →</a>
				<a href="/profit-goldeneye-bonus">Claim your <strong>Exclusive Bonuses</strong> after purchase →</a>
			</p>
		</div>
	</section>

	<StickyBar />
</BaseLayout>

<style>
	.kicker {
		margin: 0 0 0.8rem;
		color: var(--color-primary);
		font-size: 0.78rem;
		font-weight: 700;
		letter-spacing: 0.14em;
		text-transform: uppercase;
	}

	h2 {
		margin: 0;
		font-size: clamp(1.9rem, 4vw, 2.6rem);
	}

	h3 {
		margin: 0;
		font-size: 1.15rem;
	}

	.hero {
		position: relative;
		padding: 2.2rem 0 4.25rem;
		background:
			radial-gradient(ellipse 70% 55% at 50% -10%, rgba(212, 175, 55, 0.18), transparent 58%),
			linear-gradient(180deg, var(--color-bg-alt) 0%, var(--color-bg) 80%);
		overflow: hidden;
	}

	.hero::before {
		content: '';
		position: absolute;
		inset: 0;
		background-image:
			linear-gradient(rgba(248, 250, 252, 0.035) 1px, transparent 1px),
			linear-gradient(90deg, rgba(248, 250, 252, 0.035) 1px, transparent 1px);
		background-size: 72px 72px;
		mask-image: linear-gradient(180deg, #000 15%, transparent 82%);
		pointer-events: none;
	}

	.crumbs,
	.hero-copy {
		position: relative;
	}

	.hero-copy {
		margin-top: 2rem;
		text-align: center;
	}

	h1 {
		max-width: 16em;
		margin-inline: auto;
		font-size: clamp(2.15rem, 5vw, 3.6rem);
	}

	.lede,
	.section-lead,
	.fine {
		color: var(--color-text-light);
	}

	.lede {
		max-width: 42rem;
		margin: 1.1rem auto 0;
		font-size: 1.08rem;
	}

	.hero-copy :global(.btn),
	.cta-row,
	.answer :global(.btn) {
		margin-top: 1.4rem;
	}

	.crosslinks {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.75rem 1.4rem;
		margin-top: 1.25rem;
	}

	.crosslinks a {
		color: var(--color-primary);
		text-decoration: none;
	}

	.crosslinks a:hover {
		text-decoration: underline;
	}

	.band {
		padding: 4.25rem 0;
	}

	.band-alt {
		background: linear-gradient(180deg, rgba(19, 27, 42, 0.7), rgba(11, 15, 25, 0));
	}

	.narrow {
		max-width: 820px;
	}

	.narrow p + p {
		margin-top: 0.9rem;
		color: var(--color-text-light);
	}

	.section-lead {
		max-width: 44rem;
		margin-top: 0.85rem;
	}

	.answer {
		padding: 1.6rem 1.4rem 1.7rem;
		background: var(--color-bg-alt);
		border: 1px solid var(--color-primary);
		border-radius: var(--radius-lg);
		box-shadow: var(--shadow-glow);
	}

	.answer p {
		max-width: 46rem;
		margin-top: 0.9rem;
		font-size: 1.08rem;
	}

	.fine {
		font-size: 0.95rem;
	}

	.grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1rem;
		margin-top: 1.6rem;
	}

	.grid article {
		display: flex;
		gap: 0.85rem;
		align-items: flex-start;
		padding: 1.15rem 1.1rem;
		background: var(--color-bg-alt);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
	}

	.grid svg {
		flex: none;
		width: 1.4rem;
		height: 1.4rem;
		margin-top: 0.15rem;
		color: var(--color-primary);
	}

	.grid p {
		margin-top: 0.35rem;
		color: var(--color-text-light);
	}

	.table-scroll {
		margin-top: 1.5rem;
		overflow-x: auto;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
	}

	.compare {
		width: 100%;
		min-width: 40rem;
		border-collapse: collapse;
		background: var(--color-bg-alt);
	}

	caption {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}

	th,
	td {
		padding: 0.95rem 1rem;
		text-align: left;
		vertical-align: top;
		border-bottom: 1px solid var(--color-border);
	}

	thead th {
		font-family: var(--font-display);
		font-size: 0.95rem;
	}

	tbody th {
		color: var(--color-text-light);
		font-weight: 600;
	}

	.hl {
		background: rgba(212, 175, 55, 0.1);
		box-shadow: inset 0 0 0 1px rgba(212, 175, 55, 0.45);
	}

	thead .hl {
		color: var(--color-primary);
	}

	.faq-list {
		display: grid;
		gap: 0.7rem;
		margin-top: 1.4rem;
	}

	details {
		background: var(--color-bg-alt);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-md);
	}

	details[open] {
		border-color: var(--color-primary);
	}

	summary {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding: 1rem 1.1rem;
		font-family: var(--font-display);
		font-weight: 600;
		cursor: pointer;
		list-style: none;
	}

	summary::-webkit-details-marker {
		display: none;
	}

	summary::after {
		content: '+';
		color: var(--color-primary);
		font-size: 1.3rem;
		line-height: 1;
	}

	details[open] summary::after {
		content: '–';
	}

	details p {
		padding: 0 1.1rem 1.05rem;
		color: var(--color-text-light);
	}

	.final {
		padding: 0 0 1rem;
	}

	.final-inner {
		max-width: 820px;
		padding: 2rem 1.4rem 2.1rem;
		text-align: center;
		background:
			radial-gradient(ellipse at top, rgba(212, 175, 55, 0.16), transparent 55%),
			var(--color-bg-alt);
		border: 1px solid var(--color-primary);
		border-radius: var(--radius-lg);
		box-shadow: var(--shadow-glow);
	}

	.final-inner p {
		margin-top: 0.85rem;
		color: var(--color-text-light);
	}

	.final-inner :global(.btn) {
		margin-top: 1.4rem;
	}

	@media (max-width: 800px) {
		.grid {
			grid-template-columns: 1fr;
		}

		.table-scroll {
			overflow: visible;
			border: 0;
		}

		.compare {
			min-width: 0;
			background: transparent;
		}

		.compare thead {
			position: absolute;
			width: 1px;
			height: 1px;
			overflow: hidden;
			clip: rect(0, 0, 0, 0);
		}

		.compare,
		.compare tbody,
		.compare tr,
		.compare th,
		.compare td {
			display: block;
			width: auto;
		}

		.compare tr {
			margin-bottom: 0.85rem;
			overflow: hidden;
			background: var(--color-bg-alt);
			border: 1px solid var(--color-border);
			border-radius: var(--radius-lg);
		}

		.compare tbody th {
			padding: 0.85rem 1rem;
			color: var(--color-text);
			font-family: var(--font-display);
			background: rgba(212, 175, 55, 0.08);
		}

		.compare td {
			display: flex;
			justify-content: space-between;
			gap: 1rem;
			padding: 0.75rem 1rem;
			border-bottom: 0;
			border-top: 1px solid var(--color-border);
			box-shadow: none;
		}

		.compare td::before {
			content: attr(data-label);
			flex: 1 1 45%;
			color: var(--color-text-light);
			font-size: 0.82rem;
			font-weight: 600;
		}

		.compare td.hl {
			color: var(--color-text);
			background: rgba(212, 175, 55, 0.12);
		}
	}
</style>
