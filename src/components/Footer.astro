---
import Logo from './Logo.astro';
import { offerRel, offerUrl } from '../data/offer';

const links = [
	{ href: '/#review', label: 'Review' },
	{ href: '/profit-goldeneye-pricing', label: 'Pricing' },
	{ href: '/#features', label: 'Features' },
	{ href: '/#alternatives', label: 'Alternatives' },
	{ href: '/profit-goldeneye-bonus', label: 'Bonuses' },
];

const legal = [
	{ href: '/affiliate-disclosure', label: 'Affiliate Disclosure' },
	{ href: '/privacy-policy', label: 'Privacy Policy' },
	{ href: '/terms', label: 'Terms of Service' },
];

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isLegal = legal.some((item) => item.href === path);
---

<footer class="site-footer">
	<div class="container footer-grid">
		<div class="brand-col">
			<Logo />
			<p>Independent review of The Profit Goldeneye 2.0.</p>
		</div>
		<nav aria-label="Footer">
			<h2>Explore</h2>
			<ul>
				{
					links.map((link) => (
						<li>
							<a href={link.href}>{link.label}</a>
						</li>
					))
				}
			</ul>
		</nav>
		<nav aria-label="Legal">
			<h2>Legal</h2>
			<ul>
				{
					legal.map((link) => (
						<li>
							<a href={link.href}>{link.label}</a>
						</li>
					))
				}
			</ul>
		</nav>
		<div>
			<h2>The indicator</h2>
			<p>The Profit Goldeneye 2.0</p>
			{
				!isLegal && (
					<a class="btn footer-cta" href={offerUrl} target="_blank" rel={offerRel}>
						Get Goldeneye 2.0 →
					</a>
				)
			}
		</div>
	</div>
	<div class="container disclaimer">
		<p>
			Trading Forex carries a high level of risk and may not be suitable for every investor. Past performance
			is not indicative of future results. We are not financial advisors.
		</p>
	</div>
</footer>

<style>
	.site-footer {
		margin-top: 4.5rem;
		background: var(--color-bg);
		border-top: 1px solid var(--color-border);
	}

	.footer-grid {
		display: grid;
		grid-template-columns: 1.3fr 1fr 1fr 1fr;
		gap: 2rem;
		padding-block: 2.75rem 2rem;
	}

	.brand-col p,
	.footer-grid p {
		margin-top: 0.85rem;
		max-width: 28ch;
		color: var(--color-text-light);
	}

	h2 {
		margin: 0;
		font-size: 0.8rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--color-text-light);
	}

	ul {
		display: grid;
		gap: 0.55rem;
		margin: 0.9rem 0 0;
		padding: 0;
		list-style: none;
	}

	li a {
		color: var(--color-text);
		text-decoration: none;
	}

	li a:hover {
		color: var(--color-primary);
	}

	.footer-cta {
		margin-top: 1.1rem;
	}

	.disclaimer {
		padding-block: 1rem 1.25rem;
		border-top: 1px solid var(--color-border);
	}

	.disclaimer p {
		max-width: none;
		margin-top: 0;
		color: var(--color-text-light);
		font-size: 0.8rem;
		line-height: 1.5;
	}

	@media (max-width: 900px) {
		.footer-grid {
			grid-template-columns: 1fr 1fr;
		}
	}

	@media (max-width: 640px) {
		.footer-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
