---
interface JsonLd {
	[key: string]: unknown;
}

interface Props {
	title: string;
	description: string;
	canonicalURL?: string | URL;
	ogImage?: string;
	ogType?: string;
	schema?: JsonLd | JsonLd[];
	noindex?: boolean;
}

const {
	title,
	description,
	canonicalURL,
	ogImage,
	ogType = 'website',
	schema,
	noindex = false,
} = Astro.props;

const origin = Astro.site ?? new URL('https://profitgoldeneyereview.com');

const canonical = canonicalURL
	? new URL(String(canonicalURL), origin).href
	: new URL(Astro.url.pathname, origin).href;

const image = ogImage ? new URL(ogImage, origin).href : undefined;
const robots = noindex ? 'noindex, nofollow' : 'index, follow';
const schemaJson = schema ? JSON.stringify(schema).replace(/</g, '\\u003c') : undefined;
---

<title>{title}</title>
<meta name="description" content={description} />
<meta name="robots" content={robots} />
<link rel="canonical" href={canonical} />

<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:type" content={ogType} />
<meta property="og:url" content={canonical} />
<meta property="og:site_name" content="GoldeneyeReview" />
<meta property="og:locale" content="en_US" />
{image && <meta property="og:image" content={image} />}

<meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
{image && <meta name="twitter:image" content={image} />}

{schemaJson && <script type="application/ld+json" set:html={schemaJson} />}
