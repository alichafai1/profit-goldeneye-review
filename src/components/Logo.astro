---
interface Props {
	class?: string;
}

const { class: className } = Astro.props;
---

<a class:list={['logo', className]} href="/" aria-label="GoldeneyeReview home">
	<svg class="logo-mark" viewBox="0 0 40 40" aria-hidden="true">
		<path
			d="M2.8 20C7.2 12.4 12.6 8.6 20 8.6s12.8 3.8 17.2 11.4C32.8 27.6 27.4 31.4 20 31.4S7.2 27.6 2.8 20Z"
			fill="#0B0F19"
			stroke="#D4AF37"
			stroke-width="1.7"></path>
		<circle cx="20" cy="20" r="7" fill="#D4AF37"></circle>
		<path d="M16.1 14.8v10" stroke="#1A1404" stroke-width="1.15" stroke-linecap="round"></path>
		<rect x="14.7" y="16.5" width="2.8" height="4.7" rx="0.4" fill="#00C853"></rect>
		<path d="M23.9 15.3v9.7" stroke="#1A1404" stroke-width="1.15" stroke-linecap="round"></path>
		<rect x="22.5" y="17.5" width="2.8" height="4.8" rx="0.4" fill="#FF3D00"></rect>
	</svg>
	<span class="logo-word">Goldeneye<span>Review</span></span>
</a>

<style>
	.logo {
		display: inline-flex;
		align-items: center;
		gap: 0.65rem;
		min-width: 0;
		color: var(--color-text);
		text-decoration: none;
	}

	.logo-mark {
		width: 2.25rem;
		height: 2.25rem;
		flex: none;
	}

	.logo-word {
		font-family: var(--font-display);
		font-size: 1.15rem;
		font-weight: 700;
		letter-spacing: -0.03em;
		line-height: 1;
		white-space: nowrap;
	}

	.logo-word span {
		color: var(--color-primary);
	}
</style>
