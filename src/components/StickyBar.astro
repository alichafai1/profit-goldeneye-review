---
import CtaButton from './CtaButton.astro';
---

<div class="sticky-bar">
	<div class="container sticky-inner">
		<p>
			<strong>The Profit Goldeneye 2.0</strong>
			<span>$329 one-time · MT4 and MT5</span>
		</p>
		<div class="sticky-cta">
			<CtaButton>Get Goldeneye 2.0 + My Bonuses →</CtaButton>
		</div>
	</div>
</div>

<style>
	.sticky-bar {
		position: fixed;
		right: 0;
		bottom: 0;
		left: 0;
		z-index: 35;
		padding: 0.75rem 0;
		background: rgba(11, 15, 25, 0.94);
		border-top: 1px solid var(--color-primary);
		box-shadow: 0 -8px 30px rgba(0, 0, 0, 0.35);
		backdrop-filter: blur(12px);
	}

	.sticky-inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
	}

	p {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem 0.75rem;
		align-items: baseline;
	}

	strong {
		font-family: var(--font-display);
		font-weight: 700;
	}

	span {
		color: var(--color-text-light);
		font-size: 0.9rem;
	}

	@media (max-width: 700px) {
		.sticky-inner {
			align-items: stretch;
			flex-direction: column;
			gap: 0.65rem;
		}

		.sticky-cta :global(.btn) {
			width: 100%;
		}
	}
</style>

<style is:global>
	html {
		scroll-padding-top: 5.5rem;
		scroll-padding-bottom: 6.5rem;
	}

	body {
		padding-bottom: 5.5rem;
	}

	@media (max-width: 700px) {
		body {
			padding-bottom: 8.5rem;
		}
	}
</style>
